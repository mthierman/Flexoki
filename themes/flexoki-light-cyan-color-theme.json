        "terminal.border": "#e6e4d9",
        "terminal.foreground": "#100f0f",
        "terminal.inactiveSelectionBackground": "#dad8ce",
        "terminal.selectionBackground": "#cecdc3",
        "terminal.tab.activeBorder": "#24837b",
        "terminalCursor.background": "#fffcf0",
        "terminalCursor.foreground": "#100f0f",
