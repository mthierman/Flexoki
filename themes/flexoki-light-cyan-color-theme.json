        "welcomePage.tileBackground": "#e6e4d9",
        "welcomePage.tileBorder": "#e6e4d9",
        "widget.border": "#e6e4d9",
        "widget.shadow": "#100f0f40"
    },
    "tokenColors": [
        {
            "scope": "emphasis",
            "settings": {
                "fontStyle": "italic"
            }
        },
        {
            "scope": "strong",
            "settings": {
                "fontStyle": "bold"
            }
        },
        {
            "scope": "header",
            "settings": {
                "foreground": "#205ea6"
            }
        },
        {
            "scope": "comment",
            "settings": {
                "foreground": "#b7b5ac"
            }
        },
        {
            "scope": [
                "token.info-token"
            ],
            "settings": {
                "foreground": "#205ea6"
            }
        },
        {
            "scope": [
                "token.warn-token"
            ],
            "settings": {}
        },
        {
            "scope": [
                "token.error-token"
            ],
            "settings": {}
        },
        {
            "scope": [
                "token.debug-token"
            ],
            "settings": {
                "foreground": "#5e409d"
            }
        },
        {
            "scope": [
                "entity.name.function"
            ],
            "settings": {
                "foreground": "#bc5215"
            }
        },
        {
            "scope": [
                "keyword",
                "entity.name.keyword"
            ],
            "settings": {
                "foreground": "#66800b"
            }
        },
        {
            "scope": [
                "entity.name.type",
                "storage.type"
            ],
            "settings": {
                "foreground": "#5e409d"
            }
        },
        {
            "scope": [
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#5e409d"
            }
        },
        {
            "scope": [
                "string"
            ],
            "settings": {
                "foreground": "#24837b"
            }
        },
        {
            "scope": [
                "meta.object"
            ],
            "settings": {
                "foreground": "#ad8301"
            }
        },
        {
            "scope": [
                "meta.block.namespace"
            ],
            "settings": {
                "foreground": "#66800b"
            }
        },
        {
            "scope": [
                "variable"
            ],
            "settings": {
                "foreground": "#205ea6"
            }
        },
        {
            "scope": [
                "constant"
            ],
            "settings": {
                "foreground": "#ad8301"
            }
        },
        {
            "scope": [
                "constant.numeric"
            ],
            "settings": {
                "foreground": "#5e409d"
            }
        },
        {
            "scope": [
                "constant.character"
            ],
            "settings": {
                "foreground": "#24837b"
            }
        },
        {
            "scope": [
                "constant.language"
            ],
            "settings": {}
        },
        {
            "scope": [
                "invalid"
            ],
            "settings": {
                "foreground": "#af3029"
            }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "newOperator": "#6f6e69",
        "stringLiteral": "#24837b",
        "customLiteral": "#24837b",
        "numberLiteral": "#5e409d"
    }
}