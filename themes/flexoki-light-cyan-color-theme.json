            }
        },
        {
            "scope": [
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#5e409d"
            }
        },
        {
            "scope": [
                "string"
            ],
            "settings": {
                "foreground": "#24837b"
            }
        },
        {
            "scope": [
                "meta.object"
            ],
            "settings": {
                "foreground": "#ad8301"
            }
        },
        {
            "scope": [
                "meta.block.namespace"
            ],
            "settings": {
                "foreground": "#66800b"
            }
        },
        {
            "scope": [
                "punctuation"
            ],
            "settings": {
                "foreground": "#6f6e69"
            }
        },
        {
            "scope": [
                "variable"
            ],
            "settings": {
                "foreground": "#205ea6"
            }
        },
        {
            "scope": [
                "constant"
            ],
            "settings": {
                "foreground": "#ad8301"
            }
        },
        {
            "scope": [
                "constant.numeric"
            ],
            "settings": {
                "foreground": "#5e409d"
            }
        },
        {
            "scope": [
                "constant.character"
            ],
            "settings": {
                "foreground": "#24837b"
            }
        },
        {
            "scope": [
                "constant.language"
            ],
            "settings": {
                "foreground": "#a02f6f"
            }
        },
        {
            "scope": [
                "invalid"
            ],
            "settings": {
                "foreground": "#af3029"
            }
        }
