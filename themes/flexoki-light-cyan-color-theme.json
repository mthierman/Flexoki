    "tokenColors": [
        {
            "scope": [
                "emphasis"
            ],
            "settings": {
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "strong"
            ],
            "settings": {
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "header",
                "markup.heading"
            ],
            "settings": {
                "foreground": "#205ea6"
            }
        },
        {
            "scope": [
                "comment"
            ],
            "settings": {
                "foreground": "#b7b5ac"
            }
        },
        {
            "scope": [
                "token.info-token"
            ],
            "settings": {
                "foreground": "#205ea6"
            }
        },
        {
            "scope": [
                "token.warn-token"
            ],
            "settings": {
                "foreground": "#bc5215"
            }
        },
        {
            "scope": [
                "token.error-token"
            ],
            "settings": {
                "foreground": "#af3029"
            }
        },
        {
            "scope": [
                "token.debug-token"
            ],
            "settings": {
                "foreground": "#5e409d"
            }
        },
        {
            "scope": [
                "entity.name.function"
            ],
            "settings": {
                "foreground": "#bc5215"
            }
        },
        {
            "scope": [
                "keyword",
                "entity.name.keyword"
            ],
            "settings": {
                "foreground": "#66800b"
            }
        },
        {
            "scope": [
