        "widget.shadow": "#100f0f40"
    },
    "tokenColors": [
        {
            "scope": "emphasis",
            "settings": {
                "fontStyle": "italic"
            }
        },
        {
            "scope": "strong",
            "settings": {
                "fontStyle": "bold"
            }
        },
        {
            "scope": "header",
            "settings": {
                "foreground": "#4385be"
            }
        },
        {
            "scope": "comment",
            "settings": {
                "foreground": "#575653"
            }
        },
        {
            "scope": [
                "token.info-token"
            ],
            "settings": {
                "foreground": "#4385be"
            }
        },
        {
            "scope": [
                "token.warn-token"
            ],
            "settings": {}
        },
        {
            "scope": [
                "token.error-token"
            ],
            "settings": {}
        },
        {
            "scope": [
                "token.debug-token"
            ],
            "settings": {
                "foreground": "#8b7ec8"
            }
        },
        {
            "scope": [
                "entity.name.function"
            ],
            "settings": {
                "foreground": "#da702c"
            }
        },
        {
            "scope": [
                "keyword",
                "entity.name.keyword"
            ],
            "settings": {
                "foreground": "#879a39"
            }
        },
        {
            "scope": [
                "entity.name.type",
                "storage.type"
            ],
            "settings": {
                "foreground": "#8b7ec8"
            }
        },
        {
            "scope": [
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#8b7ec8"
            }
        },
        {
            "scope": [
                "string"
            ],
            "settings": {
                "foreground": "#3aa99f"
            }
        },
        {
            "scope": [
                "meta.object"
            ],
            "settings": {
                "foreground": "#d0a215"
            }
        },
        {
            "scope": [
                "meta.block.namespace"
            ],
            "settings": {
                "foreground": "#879a39"
            }
        },
        {
            "scope": [
                "variable"
            ],
            "settings": {
                "foreground": "#4385be"
            }
        },
        {
            "scope": [
                "constant"
            ],
            "settings": {
                "foreground": "#d0a215"
            }
        },
        {
            "scope": [
                "constant.numeric"
            ],
            "settings": {
                "foreground": "#8b7ec8"
            }
        },
        {
            "scope": [
                "constant.character"
            ],
            "settings": {
                "foreground": "#3aa99f"
            }
        },
        {
            "scope": [
                "constant.language"
            ],
            "settings": {}
        },
        {
            "scope": [
                "invalid"
            ],
            "settings": {
                "foreground": "#d14d41"
            }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "newOperator": "#878580",
        "stringLiteral": "#3aa99f",
        "customLiteral": "#3aa99f",
        "numberLiteral": "#8b7ec8"
    }
}