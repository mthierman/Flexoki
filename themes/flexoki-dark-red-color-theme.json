        "panel.background": "#1c1b1a",
        "panel.border": "#282726",
        "panel.dropBorder": null,
        "panelInput.border": "#403e3c",
        "panelSection.border": "#282726",
        "panelSection.dropBackground": null,
        "panelSectionHeader.background": "#100f0f",
